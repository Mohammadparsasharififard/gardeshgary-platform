# ─────────────────────────────────────────────────────────────
# متغیرهای محیطی پروژه — این فایل صرفاً نمونه است
# یک کپی با نام `.env.local` بسازید و مقادیر واقعی را در آن قرار دهید
# ─────────────────────────────────────────────────────────────

# اتصال به Supabase (در صورت استفاده از احراز هویت واقعی)
# مقادیر را از پنل Supabase خود بگیرید: Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# درگاه احراز هویت دولت (پنجره ملی خدمات دولت هوشمند)
# فعلاً صرفاً URL نمایشی است؛ برای استفاده واقعی باید توکن هم دریافت کنید
VITE_GOV_SSO_URL=https://api.my.gov.ir/v1/verify

# URL یک مدل LLM واقعی (در صورت اتصال دستیار هوشمند به مدل زبانی)
VITE_LLM_API_URL=https://api.example.com/v1/chat
VITE_LLM_API_KEY=your-llm-api-key

# تنظیمات نمایش
VITE_APP_NAME=پلتفرم ملی حقوق گردشگری
VITE_APP_VERSION=0.1.0
